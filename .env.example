# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요.
# .env 는 .gitignore 에 등록되어 있어 Git에 올라가지 않습니다.

# [필수] 세션·쿠키 암호화에 쓰이는 비밀키.
# 운영 환경에서는 반드시 임의의 긴 문자열로 바꿔야 합니다.
# 예) python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# [선택] 데이터베이스 연결 주소. 아직 DB를 쓰지 않으므로 비워둬도 됩니다.
# 예) postgresql://user:password@host:5432/dbname
DATABASE_URL=

# [필수] 실행 모드. development 또는 production
# production 으로 두면 debug 모드가 자동으로 꺼집니다.
FLASK_ENV=development
